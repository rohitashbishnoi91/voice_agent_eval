--- /dev/null
+++ b/src/tau2/voice/audio_native/livekit_session/discrete_time_adapter.py
@@ -0,0 +1,438 @@
+"""Discrete-time adapter for the AgentSession-based cascaded provider.
+
+Same tick contract as ``LiveKitCascadedAdapter`` (background asyncio loop,
+telephony ↔ PCM conversion, event queue drained within the tick budget,
+per-tick audio capping, proportional transcripts, usage ledger), but the agent
+pipeline is a real ``AgentSession``. Barge-in is *not* decided here: the
+adapter only reacts to LiveKit clearing the output buffer.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import threading
+import time
+from pathlib import Path
+from typing import Any, List, Optional, Tuple
+
+from loguru import logger
+from pydantic import BaseModel
+
+from tau2.config import (
+    DEFAULT_AUDIO_NATIVE_CONNECT_TIMEOUT,
+    DEFAULT_AUDIO_NATIVE_DISCONNECT_TIMEOUT,
+    DEFAULT_AUDIO_NATIVE_THREAD_JOIN_TIMEOUT,
+    DEFAULT_AUDIO_NATIVE_TICK_TIMEOUT_BUFFER,
+)
+from tau2.data_model.audio import AudioFormat
+from tau2.data_model.message import ToolCall
+from tau2.data_model.usage import UsageRecord
+from tau2.environment.tool import Tool
+from tau2.voice.audio_native.adapter import DiscreteTimeAdapter
+from tau2.voice.audio_native.audio_converter import StreamingTelephonyConverter
+from tau2.voice.audio_native.livekit.provider import CascadedEvent, CascadedEventType
+from tau2.voice.audio_native.livekit_session.config import SessionConfig
+from tau2.voice.audio_native.livekit_session.session_provider import (
+    SessionVoiceProvider,
+)
+from tau2.voice.audio_native.tick_result import (
+    TickResult,
+    UtteranceTranscript,
+    buffer_excess_audio,
+    get_proportional_transcript,
+)
+
+
+class LiveKitSessionVADConfig(BaseModel):
+    """Interface-compatibility placeholder (VAD lives inside the AgentSession)."""
+
+
+def _current_artifact_dir() -> Optional[Path]:
+    try:
+        from tau2.runner.batch import _current_artifact_dir
+
+        return _current_artifact_dir.get()
+    except Exception:
+        return None
+
+
+class LiveKitSessionAdapter(DiscreteTimeAdapter):
+    def __init__(
+        self,
+        tick_duration_ms: int,
+        session_config: Optional[SessionConfig] = None,
+        send_audio_instant: bool = True,
+        audio_format: Optional[AudioFormat] = None,
+        sidecar_path: Optional[Path] = None,
+    ):
+        super().__init__(tick_duration_ms, audio_format=audio_format)
+        self.session_config = session_config or SessionConfig()
+        self.send_audio_instant = send_audio_instant
+        self._sidecar_path_override = sidecar_path
+
+        self._provider: Optional[SessionVoiceProvider] = None
+        self._loop: Optional[asyncio.AbstractEventLoop] = None
+        self._thread: Optional[threading.Thread] = None
+        self._connected = False
+        self._event_queue: Optional[asyncio.Queue] = None
+
+        self._tick_count = 0
+        self._pending_tool_results: List[Tuple[str, str, bool, bool]] = []
+        self._buffered_audio_chunks: List[Tuple[bytes, Optional[str]]] = []
+        self._cumulative_user_audio_ms = 0
+        self._utterance_transcripts: dict[str, UtteranceTranscript] = {}
+        self._stt_session_counter = 0
+        self._input_rate = self.session_config.tts_input_sample_rate
+        self._converters: dict[int, StreamingTelephonyConverter] = {}
+        self._tools: List[Tool] = []
+
+    # ------------------------------------------------------------------ props
+    @property
+    def provider(self) -> Optional[SessionVoiceProvider]:
+        """The current (or last) provider. The orchestrator reads
+        ``adapter.provider.session_id`` after the agent is stopped, so this must
+        not raise once disconnected."""
+        return self._provider
+
+    @property
+    def is_connected(self) -> bool:
+        return self._connected and self._loop is not None
+
+    # -------------------------------------------------------------- lifecycle
+    def connect(
+        self,
+        system_prompt: str,
+        tools: List[Tool],
+        vad_config: Any = None,
+        modality: str = "audio",
+    ) -> None:
+        if self._connected:
+            logger.warning("Already connected, disconnecting first")
+            self.disconnect()
+        self._tools = tools
+        write_tools = self.session_config.write_tool_names or self._derive_write_tools(
+            tools
+        )
+
+        sidecar = self._sidecar_path_override
+        if sidecar is None:
+            art = _current_artifact_dir()
+            if art is not None:
+                sidecar = art / "livekit_events.jsonl"
+
+        # LiveKit plugins must be registered on the main thread. In tau2 runs this
+        # already happened (runner.batch.preregister_voice_plugins); for direct use
+        # (tests, scripts) do it here on the caller's thread before the loop starts.
+        try:
+            from tau2.voice.audio_native.livekit import preregister_livekit_plugins
+
+            preregister_livekit_plugins()
+        except Exception as e:  # pragma: no cover
+            logger.warning(f"plugin preregistration skipped: {e}")
+
+        self._start_background_loop()
+        assert self._loop is not None
+
+        async def _create_and_connect():
+            self._event_queue = asyncio.Queue()
+            self._provider = SessionVoiceProvider(
+                self.session_config, self._event_queue, sidecar_path=sidecar
+            )
+            await self._provider.connect(
+                system_prompt, tools, write_tool_names=write_tools
+            )
+
+        try:
+            fut = asyncio.run_coroutine_threadsafe(_create_and_connect(), self._loop)
+            fut.result(timeout=DEFAULT_AUDIO_NATIVE_CONNECT_TIMEOUT)
+            self._connected = True
+            self._stt_session_counter += 1
+            self._converters.clear()
+            self._buffered_audio_chunks = []
+            self._tick_count = 0
+            self._utterance_transcripts.clear()
+            logger.info(
+                f"LiveKitSessionAdapter connected (tick={self.tick_duration_ms}ms, "
+                f"bytes_per_tick={self.bytes_per_tick}, sidecar={sidecar})"
+            )
+        except Exception as e:
+            logger.error(f"Failed to connect LiveKitSessionAdapter: {e}")
+            self._stop_background_loop()
+            raise RuntimeError(f"Failed to connect livekit_session adapter: {e}") from e
+
+    @staticmethod
+    def _derive_write_tools(tools: List[Tool]) -> List[str]:
+        names = []
+        for t in tools:
+            tt = getattr(t, "tool_type", None) or getattr(t, "type", None)
+            if tt is not None and "WRITE" in str(tt).upper():
+                names.append(t.name)
+        return names
+
+    def _make_stt_usage_record(self) -> Optional[UsageRecord]:
+        if self._provider is None or self._provider.stt_audio_seconds_sent <= 0:
+            return None
+        return UsageRecord(
+            provider=self.session_config.stt.provider,
+            model=self.session_config.stt.model,
+            component="stt",
+            semantics="cumulative",
+            scope_id=f"stt-session-{self._stt_session_counter}",
+            audio_input_seconds=self._provider.stt_audio_seconds_sent,
+        )
+
+    def get_usage_records(self) -> List[UsageRecord]:
+        records = super().get_usage_records()
+        live = self._make_stt_usage_record()
+        if live is not None:
+            records.append(live)
+        return records
+
+    def disconnect(self) -> None:
+        if not self._connected:
+            return
+        rec = self._make_stt_usage_record()
+        if rec is not None:
+            self._usage_records.append(rec)
+        if self._loop is not None and self._provider is not None:
+            fut = asyncio.run_coroutine_threadsafe(
+                self._provider.disconnect(), self._loop
+            )
+            try:
+                fut.result(timeout=DEFAULT_AUDIO_NATIVE_DISCONNECT_TIMEOUT + 10)
+            except Exception as e:
+                logger.warning(f"Error during disconnect: {e}")
+        self._stop_background_loop()
+        self._connected = False
+        # keep self._provider (disconnected) so session_id stays readable
+        self._tick_count = 0
+        self._buffered_audio_chunks = []
+        self._converters.clear()
+        logger.info("LiveKitSessionAdapter disconnected")
+
+    def _start_background_loop(self) -> None:
+        if self._loop is not None:
+            return
+
+        def run_loop():
+            self._loop = asyncio.new_event_loop()
+            asyncio.set_event_loop(self._loop)
+            self._loop.run_forever()
+
+        self._thread = threading.Thread(
+            target=run_loop, daemon=True, name="lk-session-loop"
+        )
+        self._thread.start()
+        while self._loop is None:
+            time.sleep(0.01)
+
+    def _stop_background_loop(self) -> None:
+        if self._loop is not None:
+            self._loop.call_soon_threadsafe(self._loop.stop)
+            if self._thread is not None:
+                self._thread.join(timeout=DEFAULT_AUDIO_NATIVE_THREAD_JOIN_TIMEOUT)
+            self._loop = None
+            self._thread = None
+
+    # ------------------------------------------------------------------ ticks
+    def run_tick(
+        self, user_audio: bytes, tick_number: Optional[int] = None
+    ) -> TickResult:
+        if not self.is_connected:
+            raise RuntimeError("Not connected. Call connect() first.")
+        if tick_number is None:
+            tick_number = self._tick_count
+        self._tick_count = tick_number + 1
+        fut = asyncio.run_coroutine_threadsafe(
+            self._async_run_tick(user_audio, tick_number), self._loop
+        )
+        try:
+            return fut.result(
+                timeout=self.tick_duration_ms / 1000
+                + DEFAULT_AUDIO_NATIVE_TICK_TIMEOUT_BUFFER
+            )
+        except Exception as e:
+            logger.error(f"Error in run_tick (tick={tick_number}): {e}")
+            raise
+
+    def _converter_for(self, sample_rate: int) -> StreamingTelephonyConverter:
+        conv = self._converters.get(sample_rate)
+        if conv is None:
+            conv = StreamingTelephonyConverter(
+                input_sample_rate=self._input_rate, output_sample_rate=sample_rate
+            )
+            self._converters[sample_rate] = conv
+        return conv
+
+    async def _async_run_tick(self, user_audio: bytes, tick_number: int) -> TickResult:
+        loop = asyncio.get_running_loop()
+        tick_start = loop.time()
+        deadline = tick_start + self.tick_duration_ms / 1000
+        self._current_tick_number = tick_number
+
+        events: List[CascadedEvent] = []
+        tool_calls: List[ToolCall] = []
+        vad_events: List[str] = []
+        agent_audio_chunks: List[Tuple[bytes, Optional[str]]] = []
+        interrupted = False
+
+        user_audio_duration_ms = (
+            len(user_audio) / self.audio_format.bytes_per_second * 1000
+        )
+        cumulative_at_start = self._cumulative_user_audio_ms
+        self._cumulative_user_audio_ms += int(user_audio_duration_ms)
+
+        provider = self._provider
+        assert provider is not None, "run_tick before connect()"
+        # 1. deliver tool results queued since last tick
+        for call_id, result, _request_response, is_error in self._pending_tool_results:
+            provider.resolve_tool(call_id, result, is_error=is_error)
+        self._pending_tool_results.clear()
+
+        # 2. feed user audio (telephony -> 16 kHz PCM16)
+        pcm = self._converter_for(self._input_rate).convert_input(user_audio)
+        provider.push_audio(pcm)
+
+        # 3. previous tick's overflow audio first
+        if self._buffered_audio_chunks:
+            agent_audio_chunks.extend(self._buffered_audio_chunks)
+            self._buffered_audio_chunks = []
+
+        # 4. drain events until the deadline (leave a little room to drain audio)
+        drain_deadline = deadline - 0.01
+        while True:
+            remaining = drain_deadline - loop.time()
+            if remaining <= 0:
+                break
+            try:
+                ev = await asyncio.wait_for(
+                    self._event_queue.get(), timeout=max(0.001, remaining)
+                )
+            except asyncio.TimeoutError:
+                break
+            events.append(ev)
+            if self._handle_event(ev, vad_events, tool_calls):
+                interrupted = True
+                agent_audio_chunks.clear()
+
+        # 5. pull this tick's agent audio from the session output sink
+        if not interrupted:
+            for pcm_bytes, item_id, sr in self.provider.drain_output(
+                self.tick_duration_ms
+            ):
+                tel = self._converter_for(sr).convert_output(pcm_bytes)
+                agent_audio_chunks.append((tel, item_id))
+                ut = self._utterance_transcripts.setdefault(
+                    item_id, UtteranceTranscript(item_id=item_id)
+                )
+                ut.add_audio(len(tel))
+        # any TTS_COMPLETED events emitted during drain are picked up next tick
+        while not self._event_queue.empty():
+            ev = self._event_queue.get_nowait()
+            events.append(ev)
+            if self._handle_event(ev, vad_events, tool_calls):
+                interrupted = True
+                agent_audio_chunks.clear()
+
+        tick_usage = list(self._tick_usage_buffer)
+        self._tick_usage_buffer.clear()
+
+        result = TickResult(
+            tick_number=tick_number,
+            audio_sent_bytes=len(user_audio),
+            audio_sent_duration_ms=user_audio_duration_ms,
+            user_audio_data=user_audio,
+            events=events,
+            vad_events=vad_events,
+            tool_calls=tool_calls,
+            usage_records=tick_usage,
+            agent_audio_chunks=agent_audio_chunks,
+            bytes_per_tick=self.bytes_per_tick,
+            bytes_per_second=self.audio_format.bytes_per_second,
+            tick_sim_duration_ms=self.tick_duration_ms,
+            cumulative_user_audio_at_tick_start_ms=cumulative_at_start,
+        )
+        if interrupted:
+            result.was_truncated = True
+        self._buffered_audio_chunks = buffer_excess_audio(result, self.bytes_per_tick)
+        result.proportional_transcript = get_proportional_transcript(
+            result.agent_audio_chunks, self._utterance_transcripts
+        )
+
+        elapsed = loop.time() - tick_start
+        remaining = self.tick_duration_ms / 1000 - elapsed
+        if remaining > 0:
+            await asyncio.sleep(remaining)
+        logger.debug(f"Tick {tick_number}: {result.summary()}")
+        return result
+
+    def _handle_event(
+        self, ev: CascadedEvent, vad_events: List[str], tool_calls: List[ToolCall]
+    ) -> bool:
+        """Update per-tick collections. Returns True if the agent was interrupted."""
+        t = ev.type
+        if t == CascadedEventType.LLM_TOKEN:
+            item_id = ev.data.get("item_id")
+            token = ev.data.get("token") or ""
+            if item_id and token:
+                self._utterance_transcripts.setdefault(
+                    item_id, UtteranceTranscript(item_id=item_id)
+                ).add_transcript(token)
+        elif t == CascadedEventType.SPEECH_STARTED:
+            vad_events.append("speech_started")
+        elif t == CascadedEventType.SPEECH_ENDED:
+            vad_events.append("speech_stopped")
+        elif t == CascadedEventType.INTERRUPTED:
+            if ev.data.get("paused"):
+                return False  # paused for a possible false interruption; keep audio
+            vad_events.append("interrupted")
+            self._buffered_audio_chunks = []
+            self._utterance_transcripts.clear()
+            return True
+        elif t == CascadedEventType.TOOL_CALL:
+            tc = ev.tool_call
+            if tc:
+                tool_calls.append(tc)
+        elif t == CascadedEventType.USAGE:
+            d = ev.data
+            comp = d.get("component")
+            if comp == "llm":
+                self.record_usage(
+                    UsageRecord(
+                        provider=d.get("provider", "unknown"),
+                        model=d.get("model", "unknown"),
+                        component="llm",
+                        input_tokens=d.get("prompt_tokens"),
+                        output_tokens=d.get("completion_tokens"),
+                        input_cached_tokens=d.get("prompt_cached_tokens"),
+                    )
+                )
+            elif comp == "tts":
+                self.record_usage(
+                    UsageRecord(
+                        provider=d.get("provider", "unknown"),
+                        model=d.get("model", "unknown"),
+                        component="tts",
+                        characters=d.get("characters"),
+                    )
+                )
+        elif t == CascadedEventType.ERROR:
+            logger.warning(f"AgentSession error event: {ev.data}")
+        return False
+
+    # ------------------------------------------------------------------ tools
+    def send_tool_result(
+        self,
+        call_id: str,
+        result: str,
+        request_response: bool = True,
+        is_error: bool = False,
+    ) -> None:
+        self._pending_tool_results.append((call_id, result, request_response, is_error))
+        logger.debug(f"Queued tool result for call_id={call_id} (error={is_error})")
+
+    async def _execute_tick(self, user_audio, tick_number, result, tick_start):
+        raise NotImplementedError("LiveKitSessionAdapter uses its own run_tick")
+
+    async def _flush_pending_tool_results(self):
+        raise NotImplementedError("LiveKitSessionAdapter uses its own run_tick")
