+def _needs_local_chat_format(model: str) -> bool:
+    """Local chat templates (llama3.x etc. via Ollama) cannot represent a system
+    message that appears after assistant turns: the model leaks role headers and
+    may answer as the other party. Opt in automatically for Ollama models, or
+    force with TAU2_LOCAL_CHAT_FORMAT=1."""
+    import os
+
+    flag = os.environ.get("TAU2_LOCAL_CHAT_FORMAT")
+    if flag is not None:
+        return flag not in ("0", "", "false", "False")
+    return str(model).startswith(("ollama", "ollama_chat"))
+
+
+_USER_SIM_CALLS = {"user_simulator_response", "user_streaming_response"}
+_LOCAL_USERSIM_GUARD = (
+    "[System note] Reminder for the CUSTOMER role: never invent identifiers (order numbers, item ids, "
+    "emails, zip codes, names, phone numbers) or facts that are not in your instructions - if you do not know "
+    "something, say that you do not know or do not have it. Stay on the task in your instructions. "
+    "Speak only as the customer, in one short spoken turn."
+)
+
+
+def _local_usersim_guard_enabled() -> bool:
+    """LOCAL-ONLY deviation (documented): small local user-simulator models (llama3.1:8b,
+    qwen2.5:7b) invent order ids / emails when the agent asks for them, which makes tasks
+    unwinnable and poisons identifier evals. A late reminder fixes most of it.
+    Disable with TAU2_LOCAL_USERSIM_GUARD=0. Never active for cloud models."""
+    import os
+
+    return os.environ.get("TAU2_LOCAL_USERSIM_GUARD", "1") not in ("0", "", "false", "False")
+
+
+def _append_local_usersim_guard(litellm_messages: list[dict]) -> list[dict]:
+    out = list(litellm_messages)
+    if out and out[-1].get("role") == "user" and not out[-1].get("tool_calls"):
+        out[-1] = {**out[-1], "content": f"{out[-1].get('content') or ''}\n{_LOCAL_USERSIM_GUARD}".strip()}
+    else:
+        out.append({"role": "user", "content": _LOCAL_USERSIM_GUARD})
+    return out
+
+
+def _adapt_mid_conversation_system_messages(litellm_messages: list[dict]) -> list[dict]:
+    """Keep leading system messages; turn any later system message into a
+    user-role note so the template stays user/assistant-alternating."""
+    out: list[dict] = []
+    seen_non_system = False
+    for m in litellm_messages:
+        if m.get("role") == "system" and seen_non_system:
+            note = {"role": "user", "content": f"[System note] {m.get('content') or ''}".strip()}
+            # merge with a preceding user note to avoid two user turns in a row
+            if out and out[-1].get("role") == "user" and not out[-1].get("tool_calls"):
+                out[-1] = {"role": "user", "content": f"{out[-1].get('content') or ''}\n{note['content']}".strip()}
+            else:
+                out.append(note)
+            continue
+        if m.get("role") != "system":
+            seen_non_system = True
+        out.append(m)
+    return out
+
