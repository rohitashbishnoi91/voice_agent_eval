@@ -0,0 +1,166 @@
+"""Adapter tick-loop test with a stub provider (no LiveKit, no network).
+
+Exercises LiveKitSessionAdapter._async_run_tick end to end: audio conversion,
+event draining, tool-call surfacing, tool-result delivery on the next tick,
+per-tick audio capping/buffering, proportional transcripts and usage records.
+"""
+
+from __future__ import annotations
+
+from typing import List, Tuple
+
+import pytest
+
+pytest.importorskip("livekit.agents")
+
+from tau2.data_model.message import ToolCall  # noqa: E402
+from tau2.voice.audio_native.livekit.provider import (  # noqa: E402
+    CascadedEvent,
+    CascadedEventType,
+)
+from tau2.voice.audio_native.livekit_session import (
+    discrete_time_adapter as dta,  # noqa: E402
+)
+from tau2.voice.audio_native.livekit_session.config import SessionConfig  # noqa: E402
+
+
+class StubProvider:
+    """Emits a scripted event sequence; audio is 24 kHz PCM16 silence-ish."""
+
+    def __init__(self, config, event_queue, sidecar_path=None):
+        self.config = config
+        self.q = event_queue
+        self.session_id = "stub-session"
+        self.stt_audio_seconds_sent = 0.0
+        self.is_connected = False
+        self.pushed = 0
+        self.resolved: List[Tuple[str, str, bool]] = []
+        self._audio: List[Tuple[bytes, str, int]] = []
+        self._pending_audio_after_tool = False
+
+    async def connect(self, system_prompt, tools, write_tool_names=None):
+        self.is_connected = True
+        self.system_prompt = system_prompt
+        self.tools = tools
+        self.write_tool_names = write_tool_names
+
+    async def disconnect(self):
+        self.is_connected = False
+
+    def push_audio(self, pcm16: bytes):
+        self.pushed += 1
+        self.stt_audio_seconds_sent += len(pcm16) / 32000
+        if self.pushed == 1:
+            self.q.put_nowait(CascadedEvent(type=CascadedEventType.SPEECH_STARTED))
+        if self.pushed == 2:
+            self.q.put_nowait(
+                CascadedEvent(
+                    type=CascadedEventType.TRANSCRIPT_FINAL,
+                    data={"transcript": "weather in tokyo"},
+                )
+            )
+            self.q.put_nowait(CascadedEvent(type=CascadedEventType.SPEECH_ENDED))
+            self.q.put_nowait(
+                CascadedEvent(
+                    type=CascadedEventType.TOOL_CALL,
+                    data={
+                        "tool_call": ToolCall(
+                            id="call_1",
+                            name="lookup_weather",
+                            arguments={"city": "Tokyo"},
+                        )
+                    },
+                )
+            )
+
+    def resolve_tool(self, call_id, result, is_error=False):
+        self.resolved.append((call_id, result, is_error))
+        # LLM answers with text streamed to the transcript sink, then 600 ms of TTS audio
+        self.q.put_nowait(CascadedEvent(type=CascadedEventType.LLM_STARTED))
+        self.q.put_nowait(
+            CascadedEvent(type=CascadedEventType.TTS_STARTED, data={"item_id": "utt_1"})
+        )
+        for tok in ("It is ", "sunny ", "in Tokyo."):
+            self.q.put_nowait(
+                CascadedEvent(
+                    type=CascadedEventType.LLM_TOKEN,
+                    data={"item_id": "utt_1", "token": tok},
+                )
+            )
+        self.q.put_nowait(
+            CascadedEvent(
+                type=CascadedEventType.LLM_COMPLETED, data={"item_id": "utt_1"}
+            )
+        )
+        self.q.put_nowait(
+            CascadedEvent(
+                type=CascadedEventType.USAGE,
+                data={
+                    "component": "llm",
+                    "provider": "openai",
+                    "model": "gpt-4.1",
+                    "prompt_tokens": 100,
+                    "completion_tokens": 10,
+                },
+            )
+        )
+        self._audio = [(b"\x10\x00" * int(24000 * 0.6), "utt_1", 24000)]  # 600 ms
+
+    def drain_output(self, tick_ms: int):
+        if not self._audio:
+            return []
+        pcm, item, sr = self._audio[0]
+        budget = int(sr * 2 * tick_ms / 1000)
+        take, rest = pcm[:budget], pcm[budget:]
+        if rest:
+            self._audio[0] = (rest, item, sr)
+        else:
+            self._audio.clear()
+            self.q.put_nowait(
+                CascadedEvent(
+                    type=CascadedEventType.TTS_COMPLETED, data={"item_id": item}
+                )
+            )
+        return [(take, item, sr)]
+
+
+def test_adapter_tick_loop_with_stub(monkeypatch):
+    monkeypatch.setattr(dta, "SessionVoiceProvider", StubProvider)
+    adapter = dta.LiveKitSessionAdapter(
+        tick_duration_ms=200, session_config=SessionConfig()
+    )
+    adapter.connect("sys prompt", [], vad_config=None)
+    try:
+        silence = b"\x7f" * 1600  # 200 ms G.711
+        r1 = adapter.run_tick(silence, tick_number=1)
+        assert "speech_started" in r1.vad_events and not r1.tool_calls
+
+        r2 = adapter.run_tick(silence, tick_number=2)
+        assert [tc.name for tc in r2.tool_calls] == ["lookup_weather"]
+        assert "speech_stopped" in r2.vad_events
+        assert any(e.type == CascadedEventType.TRANSCRIPT_FINAL for e in r2.events)
+        assert r2.agent_audio_bytes == 0
+
+        adapter.send_tool_result("call_1", "sunny, 70 degrees")
+        r3 = adapter.run_tick(silence, tick_number=3)
+        assert adapter.provider.resolved == [("call_1", "sunny, 70 degrees", False)]
+        # 600 ms of TTS drained 200 ms per tick, capped to one tick of telephony audio
+        assert 0 < r3.agent_audio_bytes <= r3.bytes_per_tick
+        assert len(r3.get_played_agent_audio()) == r3.bytes_per_tick
+        assert r3.proportional_transcript  # part of "It is sunny in Tokyo."
+        assert any(u.component == "llm" for u in r3.usage_records)
+
+        texts = [r3.proportional_transcript]
+        audio = r3.agent_audio_bytes
+        for n in (4, 5, 6):
+            r = adapter.run_tick(silence, tick_number=n)
+            texts.append(r.proportional_transcript)
+            audio += r.agent_audio_bytes
+        assert abs(audio - 3 * 1600) <= 8  # 600 ms → ~4800 telephony bytes
+        assert "".join(texts).replace(" ", "") == "ItissunnyinTokyo."
+
+        recs = adapter.get_usage_records()
+        assert any(u.component == "stt" and u.semantics == "cumulative" for u in recs)
+    finally:
+        adapter.disconnect()
+    assert not adapter.is_connected
