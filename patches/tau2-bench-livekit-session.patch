+"""Configuration for the LiveKit AgentSession-based cascaded voice provider.
+
+Unlike ``tau2.voice.audio_native.livekit`` (which drives LiveKit *plugins*
+directly with Deepgram's VAD deciding turns), this provider runs a real
+``livekit.agents.AgentSession``: LiveKit's turn detector, endpointing,
+adaptive interruption handling and preemptive generation are all in the loop,
+so behaviours governed by those components can be evaluated.
+
+Presets (``SESSION_CONFIGS``) mirror the leaderboard "Cascaded baseline"
+pipeline (Deepgram nova-3 STT → OpenAI gpt-4.1 → Deepgram aura-asteria-en TTS)
+and only differ in how turn taking is handled.
+"""
+
+import os
+from typing import Dict, Literal, Optional, Union
+
+from pydantic import BaseModel, Field
+
+# Re-use the component configs of the plugin-level cascaded provider so the
+# two providers describe the same pipeline with the same fields.
+from tau2.voice.audio_native.livekit.config import (
+    AnthropicLLMConfig,
+    DeepgramSTTConfig,
+    DeepgramTTSConfig,
+    ElevenLabsTTSConfig,
+    OpenAILLMConfig,
+)
+
+
+class OpenAICompatLLMConfig(BaseModel):
+    """Any OpenAI-compatible chat-completions endpoint (Groq, Ollama, Hugging Face
+    router, OpenRouter, vLLM, ...). Tool calling must be supported by the model."""
+
+    provider: Literal["openai_compat"] = "openai_compat"
+    model: str = "llama-3.3-70b-versatile"
+    base_url: str = "https://api.groq.com/openai/v1"
+    api_key_env: str = Field(
+        default="GROQ_API_KEY",
+        description="Env var holding the key. Use 'NONE' for keyless local servers (Ollama).",
+    )
+    temperature: Optional[float] = None
+    parallel_tool_calls: Optional[bool] = None
+    max_completion_tokens: Optional[int] = None
+
+
+class OpenAICompatSTTConfig(BaseModel):
+    """OpenAI-compatible /audio/transcriptions endpoint (non-streaming; the
+    AgentSession wraps it with VAD). E.g. a local faster-whisper server."""
+
+    provider: Literal["openai_compat"] = "openai_compat"
+    model: str = "whisper-1"
+    base_url: str = "http://localhost:8000/v1"
+    api_key_env: str = "NONE"
+    language: str = "en"
+
+
+class OpenAICompatTTSConfig(BaseModel):
+    """OpenAI-compatible /audio/speech endpoint, e.g. a local Kokoro-FastAPI server."""
+
+    provider: Literal["openai_compat"] = "openai_compat"
+    model: str = "kokoro"
+    voice: str = "af_heart"
+    base_url: str = "http://localhost:8880/v1"
+    api_key_env: str = "NONE"
+    sample_rate: int = 24000
+
+
+LLMConfig = Union[OpenAILLMConfig, AnthropicLLMConfig, OpenAICompatLLMConfig]
+STTConfig = Union[DeepgramSTTConfig, OpenAICompatSTTConfig]
+TTSConfig = Union[DeepgramTTSConfig, ElevenLabsTTSConfig, OpenAICompatTTSConfig]
+
+TurnDetectionMode = Literal["turn_detector", "vad", "stt", "manual"]
+InterruptionMode = Literal["adaptive", "vad"]
+
+
+class TurnHandlingConfig(BaseModel):
+    """Subset of LiveKit ``TurnHandlingOptions`` we expose for experiments.
+
+    Field names follow the LiveKit docs (Python SDK, seconds).
+    """
+
+    turn_detection: TurnDetectionMode = Field(
+        default="turn_detector",
+        description=(
+            "'turn_detector' = LiveKit audio end-of-turn model (default, recommended); "
+            "'vad' = Silero VAD silence only; 'stt' = STT endpointing cues; "
+            "'manual' = explicit control (not used here)."
+        ),
+    )
+    turn_detector_version: Optional[Literal["v1", "v1-mini"]] = Field(
+        default=None,
+        description="LiveKit turn detector version. None = SDK default "
+        "(v1 on LiveKit Cloud / with Cloud credentials, v1-mini locally).",
+    )
+    unlikely_threshold: Optional[float] = Field(
+        default=None,
+        description="Turn detector end-of-turn threshold override (lower = more eager).",
+    )
+    endpointing_mode: Literal["fixed", "dynamic"] = "fixed"
+    endpointing_min_delay: float = Field(
+        default=0.5,
+        description="Seconds of silence before the turn can end. LiveKit default 0.5 "
+        "(the SDK lowers unset values to 0.3 when the audio turn detector is used).",
+    )
+    endpointing_max_delay: float = Field(
+        default=3.0,
+        description="Seconds before the turn is force-closed. LiveKit default 3.0 "
+        "(2.5 with the audio turn detector).",
+    )
+
+    interruptions_enabled: bool = True
+    interruption_mode: Optional[InterruptionMode] = Field(
+        default=None,
+        description="'adaptive' = LiveKit barge-in model (needs aligned-transcript STT); "
+        "'vad' = VAD-only. None = SDK auto-selection.",
+    )
+    min_interruption_duration: float = Field(
+        default=0.5,
+        description="Seconds of user speech before it counts as a barge-in.",
+    )
+    min_interruption_words: int = Field(
+        default=0, description="Minimum transcribed words before a barge-in counts."
+    )
+    false_interruption_timeout: Optional[float] = Field(
+        default=2.0,
+        description="Seconds of silence after an interruption before it is deemed false "
+        "and speech resumes. None disables false-interruption handling.",
+    )
+    resume_false_interruption: bool = True
+
+    preemptive_generation: bool = Field(
+        default=True,
+        description="Start the LLM on the final transcript before the turn is confirmed.",
+    )
+
+
+class VADConfig(BaseModel):
+    """Silero VAD parameters (``livekit.agents.inference.VAD`` / silero plugin)."""
+
+    min_speech_duration: float = 0.05
+    min_silence_duration: float = Field(
+        default=0.55,
+        description="Must be >= 0.25 when the audio turn detector is used.",
+    )
+    prefix_padding_duration: float = 0.5
+    activation_threshold: float = 0.5
+
+
+class SessionConfig(BaseModel):
+    """Full configuration for the AgentSession-based cascaded provider."""
+
+    stt: STTConfig = Field(default_factory=DeepgramSTTConfig)
+    llm: LLMConfig = Field(default_factory=OpenAILLMConfig)
+    tts: TTSConfig = Field(default_factory=DeepgramTTSConfig)
+    vad: VADConfig = Field(default_factory=VADConfig)
+    turn_handling: TurnHandlingConfig = Field(default_factory=TurnHandlingConfig)
+
+    llm_timeout_s: Optional[float] = Field(
+        default=None,
+        description="Per-attempt LLM request timeout (livekit APIConnectOptions.timeout, default 10 s). "
+        "Local models need more: a cold prompt evaluation of the 4k-token retail prompt takes 7-8 s on a laptop.",
+    )
+    max_tool_steps: int = Field(
+        default=3,
+        description="LiveKit AgentSession max consecutive tool calls per turn.",
+    )
+    write_tool_names: list[str] = Field(
+        default_factory=list,
+        description="τ-bench tools that mutate state; executed with interruptions "
+        "disallowed so a barge-in cannot cancel a half-applied write. Empty = derive "
+        "from the domain's ToolType.WRITE tools at connect time.",
+    )
+    tts_input_sample_rate: int = Field(
+        default=16000,
+        description="PCM sample rate fed into the session (Deepgram STT expects 16 kHz).",
+    )
+    events_sidecar: bool = Field(
+        default=True,
+        description="Write LiveKit-side events (transcripts, state changes, interruptions, "
+        "per-turn metrics) to a per-simulation JSONL sidecar for the behaviour evals.",
+    )
+    log_prompts: bool = False
+
+
+# Keep DeepgramTTSConfig / ElevenLabsTTSConfig etc. importable from here too.
+__all__ = [
+    "AnthropicLLMConfig",
+    "DeepgramSTTConfig",
+    "DeepgramTTSConfig",
+    "ElevenLabsTTSConfig",
+    "InterruptionMode",
+    "LLMConfig",
+    "OpenAICompatLLMConfig",
+    "OpenAICompatSTTConfig",
+    "OpenAICompatTTSConfig",
+    "OpenAILLMConfig",
+    "SESSION_CONFIGS",
+    "STTConfig",
+    "SessionConfig",
+    "TTSConfig",
+    "TurnDetectionMode",
+    "TurnHandlingConfig",
+    "VADConfig",
+]
+
+
+SESSION_CONFIGS: Dict[str, SessionConfig] = {
+    # Same models as the leaderboard "Cascaded baseline" row, with LiveKit's
+    # recommended turn handling (audio turn detector + adaptive interruption).
+    "cascaded-session": SessionConfig(
+        stt=DeepgramSTTConfig(model="nova-3"),
+        llm=OpenAILLMConfig(model="gpt-4.1"),
+        tts=DeepgramTTSConfig(model="aura-asteria-en"),
+        turn_handling=TurnHandlingConfig(
+            turn_detection="turn_detector",
+            interruption_mode="adaptive",
+        ),
+    ),
+    # Config ablation: VAD-only turn detection and VAD-only interruptions.
+    # Closest AgentSession analogue of the plugin-level baseline's behaviour.
+    "cascaded-session-vad": SessionConfig(
+        stt=DeepgramSTTConfig(model="nova-3"),
+        llm=OpenAILLMConfig(model="gpt-4.1"),
+        tts=DeepgramTTSConfig(model="aura-asteria-en"),
+        turn_handling=TurnHandlingConfig(
+            turn_detection="vad",
+            interruption_mode="vad",
+        ),
+    ),
+    # Local-only variant: on-CPU v1-mini turn detector and VAD-based interruptions
+    # (the adaptive interruption model is served by LiveKit Cloud). No LiveKit
+    # Cloud credentials needed.
+    "cascaded-session-mini": SessionConfig(
+        stt=DeepgramSTTConfig(model="nova-3"),
+        llm=OpenAILLMConfig(model="gpt-4.1"),
+        tts=DeepgramTTSConfig(model="aura-asteria-en"),
+        turn_handling=TurnHandlingConfig(
+            turn_detection="turn_detector",
+            turn_detector_version="v1-mini",
+            interruption_mode="vad",
+        ),
+    ),
+    # ---- Free-tier stacks (no paid keys) -------------------------------------
+    # Groq free tier for the LLM (fast, tool calling), Deepgram on its signup
+    # credit for STT/TTS, local v1-mini turn detector, VAD interruptions.
+    "free-groq": SessionConfig(
+        stt=DeepgramSTTConfig(model="nova-3"),
+        llm=OpenAICompatLLMConfig(
+            model="llama-3.3-70b-versatile",
+            base_url="https://api.groq.com/openai/v1",
+            api_key_env="GROQ_API_KEY",
+        ),
+        tts=DeepgramTTSConfig(model="aura-asteria-en"),
+        turn_handling=TurnHandlingConfig(
+            turn_detection="turn_detector",
+            turn_detector_version="v1-mini",
+            interruption_mode="vad",
+        ),
+    ),
+    # Fully local, no keys: Ollama LLM (scripts/local_stack.sh up), local
+    # faster-whisper STT server (:8000) and Kokoro TTS server (:8880).
+    "local": SessionConfig(
+        stt=OpenAICompatSTTConfig(model="whisper-1", base_url="http://localhost:8000/v1"),
+        llm=OpenAICompatLLMConfig(
+            # qwen2.5:7b (default since 2026-09-29): on the text pre-screen it never fabricates
+            # writes or placeholder lookups, unlike llama3.1:8b, so its voice-run failures are
+            # the voice-specific ones we evaluate. TAU2_LOCAL_LLM=llama3.1:8b switches back.
+            model=os.environ.get("TAU2_LOCAL_LLM", "qwen2.5:7b"),
+            base_url="http://localhost:11434/v1", api_key_env="NONE",
+            parallel_tool_calls=False,
+        ),
+        tts=OpenAICompatTTSConfig(model="kokoro", voice="af_heart", base_url="http://localhost:8880/v1"),
+        turn_handling=TurnHandlingConfig(
+            turn_detection="turn_detector",
+            turn_detector_version="v1-mini",
+            interruption_mode="vad",
+        ),
+        llm_timeout_s=40.0,
+    ),
+    # Ollama LLM with Deepgram audio (keyless LLM, signup-credit audio).
+    # Config ablation for behaviour 2 (planned): same as `local` but a backchannel must be
+    # >= 2 transcribed words and >= 1.0 s before it counts as a barge-in. Not a prompt change;
+    # bounds how much of S_BC is reachable by prompts at all on this stack.
+    "local-bc": SessionConfig(
+        stt=OpenAICompatSTTConfig(model="whisper-1", base_url="http://localhost:8000/v1"),
+        llm=OpenAICompatLLMConfig(
+            model=os.environ.get("TAU2_LOCAL_LLM", "qwen2.5:7b"),
+            base_url="http://localhost:11434/v1", api_key_env="NONE",
+            parallel_tool_calls=False,
+        ),
+        tts=OpenAICompatTTSConfig(model="kokoro", voice="af_heart", base_url="http://localhost:8880/v1"),
+        turn_handling=TurnHandlingConfig(
+            turn_detection="turn_detector",
+            turn_detector_version="v1-mini",
+            interruption_mode="vad",
+            min_interruption_duration=1.0,
+            min_interruption_words=2,
+        ),
+        llm_timeout_s=40.0,
+    ),
+    "free-ollama-deepgram": SessionConfig(
+        stt=DeepgramSTTConfig(model="nova-3"),
