+"""AgentSession-backed voice provider.
+
+Everything here runs on the adapter's background asyncio loop. The provider
+owns one ``AgentSession`` per simulation and exposes three tick-friendly
+operations to the adapter:
+
+- ``push_audio(pcm16)``          user audio for this tick (16 kHz PCM16)
+- ``drain_output(tick_ms)``      agent audio produced so far, paced to the tick
+- ``resolve_tool(call_id, ...)`` deliver a τ-bench tool result
+
+and a ``CascadedEvent`` stream (same event vocabulary as the plugin-level
+cascaded provider) that the adapter maps onto ``TickResult``.
+
+LiveKit-side signals that the τ-bench trajectory cannot represent
+(final transcripts as heard by the agent, user/agent state changes,
+overlapping-speech verdicts, false interruptions, per-turn metrics) are
+appended to a JSONL sidecar next to the simulation's audio artifacts.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import time
+import uuid
+from collections import deque
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+
+from loguru import logger
+
+from tau2.data_model.message import ToolCall
+from tau2.environment.tool import Tool
+from tau2.voice.audio_native.livekit.config import (
+    AnthropicLLMConfig,
+    DeepgramSTTConfig,
+    DeepgramTTSConfig,
+    ElevenLabsTTSConfig,
+    OpenAILLMConfig,
+)
+from tau2.voice.audio_native.livekit.provider import CascadedEvent, CascadedEventType
+from tau2.voice.audio_native.livekit_session.config import (
+    OpenAICompatLLMConfig,
+    OpenAICompatSTTConfig,
+    OpenAICompatTTSConfig,
+    SessionConfig,
+)
+
+
+def _resolve_key(env_name: str) -> str:
+    """API key for OpenAI-compatible endpoints; keyless servers get a placeholder."""
+    import os
+
+    if not env_name or env_name.upper() == "NONE":
+        return "not-needed"
+    key = os.environ.get(env_name)
+    if not key:
+        raise ValueError(f"{env_name} is not set (required by the configured endpoint)")
+    return key
+
+# Sidecar event types we persist (everything else is dropped to keep files small).
+SIDECAR_EVENT_TYPES = {
+    "user_input_transcribed",
+    "user_state_changed",
+    "agent_state_changed",
+    "agent_false_interruption",
+    "overlapping_speech",
+    "function_tools_executed",
+    "conversation_item_added",
+    "metrics_collected",
+    "user_transcription_timeout",
+    "error",
+    "close",
+}
+_SIDECAR_EXCLUDE = {"speech_input", "probabilities", "speech_handle"}
+
+
+# =============================================================================
+# Tick-paced audio / text I/O for the AgentSession
+# =============================================================================
+
+
+def _lk_io():
+    from livekit.agents.voice import io as lk_io
+
+    return lk_io
+
+
+@dataclass
+class _AudioSegment:
+    item_id: str
+    sample_rate: int
+    chunks: deque = field(default_factory=deque)  # bytes not yet drained
+    received_bytes: int = 0
+    drained_bytes: int = 0
+    complete: bool = False  # flush() seen
+    started: bool = False  # first bytes drained (playback started)
+    finished: bool = False  # on_playback_finished reported
+
+    @property
+    def bytes_per_second(self) -> int:
+        return self.sample_rate * 2  # mono PCM16
+
+
+class TickAudioInput:
+    """AudioInput fed by the tick loop; splits pushed PCM16 into 20 ms frames."""
+
+    def __init__(self, sample_rate: int) -> None:
+        lk_io = _lk_io()
+
+        class _Impl(lk_io.AudioInput):
+            def __init__(inner, sr: int) -> None:
+                super().__init__(label="TauTickAudioInput")
+                inner._sr = sr
+                inner._queue: asyncio.Queue = asyncio.Queue()
+                inner._closed = False
+
+            async def __anext__(inner):
+                from livekit import rtc
+
+                frame = await inner._queue.get()
+                if frame is None:
+                    raise StopAsyncIteration
+                assert isinstance(frame, rtc.AudioFrame)
+                return frame
+
+            def push(inner, pcm16: bytes) -> None:
+                from livekit import rtc
+
+                if inner._closed or not pcm16:
+                    return
+                frame_bytes = int(inner._sr * 0.02) * 2  # 20 ms
+                for i in range(0, len(pcm16), frame_bytes):
+                    chunk = pcm16[i : i + frame_bytes]
+                    if len(chunk) % 2:
+                        chunk = chunk[:-1]
+                    if not chunk:
+                        continue
+                    inner._queue.put_nowait(
+                        rtc.AudioFrame(
+                            data=chunk,
+                            sample_rate=inner._sr,
+                            num_channels=1,
+                            samples_per_channel=len(chunk) // 2,
+                        )
+                    )
+
+            def close(inner) -> None:
+                inner._closed = True
+                inner._queue.put_nowait(None)
+
+        self.impl = _Impl(sample_rate)
+
+    def push(self, pcm16: bytes) -> None:
+        self.impl.push(pcm16)
+
+    def close(self) -> None:
+        self.impl.close()
+
+
+class TickAudioOutput:
+    """AudioOutput whose "playback" is the tick loop draining bytes.
+
+    LiveKit pushes synthesized frames faster than real time; we buffer them and
+    hand out at most one tick's worth per ``drain()``. Playback-finished is
+    reported to the session when a flushed segment has been fully drained (so
+    the agent state machine follows the *simulated* playback), or immediately
+    with ``interrupted=True`` when LiveKit clears the buffer on a barge-in.
+    """
+
+    def __init__(self, emit) -> None:
+        lk_io = _lk_io()
+
+        class _Impl(lk_io.AudioOutput):
+            def __init__(inner) -> None:
+                super().__init__(
+                    label="TauTickAudioOutput",
+                    capabilities=lk_io.AudioOutputCapabilities(pause=True),
+                    sample_rate=None,
+                )
+                inner._segments: deque[_AudioSegment] = deque()
+                inner._current: Optional[_AudioSegment] = None
+                inner._counter = 0
+                inner._paused = False
+
+            async def capture_frame(inner, frame) -> None:
+                await super().capture_frame(frame)
+                if inner._current is None:
+                    inner._counter += 1
+                    seg = _AudioSegment(
+                        item_id=f"utt_{inner._counter}", sample_rate=frame.sample_rate
+                    )
+                    inner._segments.append(seg)
+                    inner._current = seg
+                    emit(CascadedEventType.TTS_STARTED, {"item_id": seg.item_id})
+                data = bytes(frame.data)
+                inner._current.chunks.append(data)
+                inner._current.received_bytes += len(data)
+
+            def flush(inner) -> None:
+                super().flush()
+                if inner._current is not None:
+                    inner._current.complete = True
+                    inner._current = None
+
+            def clear_buffer(inner) -> None:
+                # LiveKit decided the user interrupted (or the session is closing).
+                discarded = 0
+                last_pos = 0.0
+                had_pending = False
+                for seg in list(inner._segments):
+                    remaining = seg.received_bytes - seg.drained_bytes
+                    discarded += remaining
+                    last_pos = seg.drained_bytes / seg.bytes_per_second
+                    if not seg.finished:
+                        had_pending = True
+                        seg.finished = True
+                        inner.on_playback_finished(
+                            playback_position=last_pos, interrupted=True
+                        )
+                inner._segments.clear()
+                inner._current = None
+                inner._paused = False
+                if had_pending or discarded:
+                    emit(CascadedEventType.INTERRUPTED, {"discarded_bytes": discarded})
+
+            def pause(inner) -> None:
+                inner._paused = True
+                emit(CascadedEventType.INTERRUPTED, {"paused": True})
+
+            def resume(inner) -> None:
+                inner._paused = False
+
+            @property
+            def paused(inner) -> bool:
+                return inner._paused
+
+            def drain(inner, tick_ms: int) -> List[Tuple[bytes, str, int]]:
+                """Return [(pcm16, item_id, sample_rate)] worth <= tick_ms of audio."""
+                out: List[Tuple[bytes, str, int]] = []
+                if inner._paused:
+                    return out
+                budget_sec = tick_ms / 1000.0
+                while inner._segments and budget_sec > 1e-6:
+                    seg = inner._segments[0]
+                    budget_bytes = int(budget_sec * seg.bytes_per_second) & ~1
+                    if budget_bytes <= 0:
+                        break
+                    taken = bytearray()
+                    while seg.chunks and len(taken) < budget_bytes:
+                        chunk = seg.chunks[0]
+                        need = budget_bytes - len(taken)
+                        if len(chunk) <= need:
+                            taken += chunk
+                            seg.chunks.popleft()
+                        else:
+                            taken += chunk[:need]
+                            seg.chunks[0] = chunk[need:]
+                    if taken:
+                        if not seg.started:
+                            seg.started = True
+                            inner.on_playback_started(created_at=time.time())
+                        seg.drained_bytes += len(taken)
+                        out.append((bytes(taken), seg.item_id, seg.sample_rate))
+                        budget_sec -= len(taken) / seg.bytes_per_second
+                    if seg.complete and not seg.chunks:
+                        # Fully played out.
+                        inner._segments.popleft()
+                        if not seg.finished:
+                            seg.finished = True
+                            inner.on_playback_finished(
+                                playback_position=seg.drained_bytes
+                                / seg.bytes_per_second,
+                                interrupted=False,
+                            )
+                        emit(CascadedEventType.TTS_COMPLETED, {"item_id": seg.item_id})
+                        continue
+                    if not seg.chunks:
+                        break  # waiting for more TTS audio of this segment
+                return out
+
+            def has_pending_audio(inner) -> bool:
+                return any(seg.chunks for seg in inner._segments)
+
+        self.impl = _Impl()
+
+    def drain(self, tick_ms: int):
+        return self.impl.drain(tick_ms)
+
+    def has_pending_audio(self) -> bool:
+        return self.impl.has_pending_audio()
+
+
+class TickTextOutput:
+    """TextOutput capturing the agent's spoken text per segment (for the
+    proportional transcript shown to the user simulator)."""
+
+    def __init__(self, emit) -> None:
+        lk_io = _lk_io()
+
+        class _Impl(lk_io.TextOutput):
+            def __init__(inner) -> None:
+                super().__init__(label="TauTickTextOutput", next_in_chain=None)
+                inner._counter = 0
+                inner._open = False
+
+            async def capture_text(inner, text: str) -> None:
+                if not inner._open:
+                    inner._counter += 1
+                    inner._open = True
+                emit(
+                    CascadedEventType.LLM_TOKEN,
+                    {"item_id": f"utt_{inner._counter}", "token": text},
+                )
+
+            def flush(inner) -> None:
+                if inner._open:
+                    emit(
+                        CascadedEventType.LLM_COMPLETED,
+                        {"item_id": f"utt_{inner._counter}"},
+                    )
+                inner._open = False
+
+        self.impl = _Impl()
+
+
+# =============================================================================
+# Provider
+# =============================================================================
+
+
+def build_llm(c):
+    """LiveKit LLM plugin instance for an LLM config (shared with agent/retail_agent.py)."""
+    if isinstance(c, OpenAILLMConfig):
+        from livekit.plugins import openai
+
+        kwargs: Dict[str, Any] = {"model": c.model}
+        if c.temperature is not None:
+            kwargs["temperature"] = c.temperature
+        if c.reasoning_effort is not None:
+            kwargs["reasoning_effort"] = c.reasoning_effort
+        if c.parallel_tool_calls is not None:
+            kwargs["parallel_tool_calls"] = c.parallel_tool_calls
+        if c.max_completion_tokens is not None:
+            kwargs["max_completion_tokens"] = c.max_completion_tokens
+        return openai.LLM(**kwargs)
+    if isinstance(c, AnthropicLLMConfig):
+        from livekit.plugins import anthropic
+
+        kwargs = {"model": c.model, "max_tokens": c.max_tokens}
+        if c.temperature is not None:
+            kwargs["temperature"] = c.temperature
+        return anthropic.LLM(**kwargs)
+    if isinstance(c, OpenAICompatLLMConfig):
+        from livekit.plugins import openai
+
+        kwargs = {
+            "model": c.model,
+            "base_url": c.base_url,
+            "api_key": _resolve_key(c.api_key_env),
+        }
+        if c.temperature is not None:
+            kwargs["temperature"] = c.temperature
+        if c.parallel_tool_calls is not None:
+            kwargs["parallel_tool_calls"] = c.parallel_tool_calls
+        if c.max_completion_tokens is not None:
+            kwargs["max_completion_tokens"] = c.max_completion_tokens
+        return openai.LLM(**kwargs)
+    raise ValueError(f"Unsupported LLM config: {type(c)}")
+
+
+
+class SessionVoiceProvider:
+    """One LiveKit AgentSession bridged to the τ-bench tick loop."""
+
+    def __init__(
+        self,
+        config: SessionConfig,
+        event_queue: "asyncio.Queue[CascadedEvent]",
+        sidecar_path: Optional[Path] = None,
+    ) -> None:
+        self.config = config
+        self.session_id = f"lksess-{uuid.uuid4()}"
+        self._event_queue = event_queue
+        self._sidecar_path = sidecar_path
+        self._sidecar_fh = None
+        self._session = None
+        self._agent = None
+        self._stt = self._llm = self._tts = self._vad = None
+        self._pending_tools: Dict[str, asyncio.Future] = {}
+        self._write_tools: set[str] = set()
+        self._connected = False
+        self.audio_in: Optional[TickAudioInput] = None
+        self.audio_out: Optional[TickAudioOutput] = None
+        self.text_out: Optional[TickTextOutput] = None
+        self.stt_audio_seconds_sent: float = 0.0
+        self.pushed_audio_bytes: int = 0
+
+    # ---- events -----------------------------------------------------------
+
+    def _emit(self, etype: CascadedEventType, data: Optional[dict] = None) -> None:
+        self._event_queue.put_nowait(CascadedEvent(type=etype, data=data or {}))
+
+    def _sidecar(self, ev: Any) -> None:
+        if self._sidecar_fh is None:
+            return
+        try:
+            if hasattr(ev, "model_dump"):
+                rec = ev.model_dump(
+                    mode="json", exclude=_SIDECAR_EXCLUDE, warnings=False
+                )
+            elif isinstance(ev, dict):
+                rec = ev
+            else:
+                rec = {"type": type(ev).__name__, "repr": repr(ev)[:500]}
+            rec.setdefault("t", time.time())
+            self._sidecar_fh.write(json.dumps(rec, default=str) + "\n")
+            self._sidecar_fh.flush()
+        except Exception as e:  # never let logging break the call
+            logger.debug(f"sidecar write failed: {e}")
+
+    @property
+    def is_connected(self) -> bool:
+        return self._connected
+
+    # ---- lifecycle --------------------------------------------------------
+
+    async def connect(
+        self,
+        system_prompt: str,
+        tools: List[Tool],
+        write_tool_names: Optional[List[str]] = None,
+    ) -> None:
+        from livekit.agents import Agent, AgentSession
+
+        cfg = self.config
+        self._write_tools = set(write_tool_names or cfg.write_tool_names or [])
+        if self._sidecar_path and cfg.events_sidecar:
+            self._sidecar_path.parent.mkdir(parents=True, exist_ok=True)
+            self._sidecar_fh = open(self._sidecar_path, "a")
+            self._sidecar(
+                {
+                    "type": "session_start",
+                    "session_id": self.session_id,
+                    "config": cfg.model_dump(),
+                }
+            )
+
+        self._stt = self._build_stt()
+        self._llm = self._build_llm()
+        self._tts = self._build_tts()
+        self._vad = self._build_vad()
+        turn_handling = self._build_turn_handling()
+
+        self.audio_in = TickAudioInput(cfg.tts_input_sample_rate)
+        self.audio_out = TickAudioOutput(self._emit)
+        self.text_out = TickTextOutput(self._emit)
+
+        session_kwargs: Dict[str, Any] = {}
+        if cfg.llm_timeout_s:
+            from livekit.agents import APIConnectOptions
+            from livekit.agents.voice.agent_session import SessionConnectOptions
+
+            session_kwargs["conn_options"] = SessionConnectOptions(
+                llm_conn_options=APIConnectOptions(timeout=cfg.llm_timeout_s)
+            )
+        session = AgentSession(
+            stt=self._stt,
+            llm=self._llm,
+            tts=self._tts,
+            vad=self._vad,
+            turn_handling=turn_handling,
+            max_tool_steps=cfg.max_tool_steps,
+            loop=asyncio.get_running_loop(),
+            **session_kwargs,
+        )
+        session.input.audio = self.audio_in.impl
+        session.output.audio = self.audio_out.impl
+        session.output.transcription = self.text_out.impl
+        self._register_session_events(session)
+        self._register_metrics()
+
+        lk_tools = [self._make_tool(t) for t in tools]
+        self._agent = Agent(instructions=system_prompt, tools=lk_tools)
+        self._session = session
+        if cfg.log_prompts:
+            logger.info(f"AgentSession system prompt:\n{system_prompt}")
+        await session.start(self._agent, record=False)
+        self._connected = True
+        logger.info(
+            f"SessionVoiceProvider connected: stt={cfg.stt.provider}/{cfg.stt.model} "
+            f"llm={cfg.llm.provider}/{cfg.llm.model} tts={cfg.tts.provider}/{cfg.tts.model} "
+            f"turn_detection={cfg.turn_handling.turn_detection} "
+            f"interruption={cfg.turn_handling.interruption_mode or 'auto'}"
+        )
+
+    async def disconnect(self) -> None:
+        self._connected = False
+        for fut in self._pending_tools.values():
+            if not fut.done():
+                fut.cancel()
+        self._pending_tools.clear()
+        if self.audio_in:
+            self.audio_in.close()
+        if self._session is not None:
+            try:
+                await asyncio.wait_for(self._session.aclose(), timeout=10)
+            except Exception as e:
+                logger.warning(f"AgentSession close error: {e}")
+            self._session = None
+        if self._sidecar_fh:
+            self._sidecar({"type": "session_end", "session_id": self.session_id})
+            self._sidecar_fh.close()
+            self._sidecar_fh = None
+
+    # ---- component builders ----------------------------------------------
+
+    def _build_stt(self):
+        c = self.config.stt
+        if isinstance(c, DeepgramSTTConfig):
+            from livekit.plugins import deepgram
+
+            kwargs: Dict[str, Any] = dict(
+                model=c.model,
+                language=c.language,
+                interim_results=c.interim_results,
+                punctuate=c.punctuate,
+                smart_format=c.smart_format,
+            )
+            try:
+                return deepgram.STT(**kwargs, endpointing_ms=c.endpointing_ms)
+            except TypeError:
+                return deepgram.STT(**kwargs)
+        if isinstance(c, OpenAICompatSTTConfig):
+            from livekit.plugins import openai
+
+            return openai.STT(
+                model=c.model,
+                language=c.language,
+                base_url=c.base_url,
+                api_key=_resolve_key(c.api_key_env),
+            )
+        raise ValueError(f"Unsupported STT config: {type(c)}")
+
+    def _build_llm(self):
+        return build_llm(self.config.llm)
+
+    def _build_tts(self):
+        c = self.config.tts
+        if isinstance(c, DeepgramTTSConfig):
+            from livekit.plugins import deepgram
+
+            try:
+                return deepgram.TTS(model=c.model, sample_rate=c.sample_rate)
+            except TypeError:
+                return deepgram.TTS(model=c.model)
+        if isinstance(c, ElevenLabsTTSConfig):
+            from livekit.plugins import elevenlabs
+
+            return elevenlabs.TTS(voice_id=c.voice_id, model=c.model)
+        if isinstance(c, OpenAICompatTTSConfig):
+            from livekit.plugins import openai
+
+            return openai.TTS(
+                model=c.model,
+                voice=c.voice,
+                base_url=c.base_url,
+                api_key=_resolve_key(c.api_key_env),
+                response_format="pcm",
+            )
+        raise ValueError(f"Unsupported TTS config: {type(c)}")
+
+    def _build_vad(self):
+        v = self.config.vad
+        try:
+            from livekit.agents import inference
+
+            return inference.VAD(
+                model="silero",
+                min_speech_duration=v.min_speech_duration,
+                min_silence_duration=v.min_silence_duration,
+                prefix_padding_duration=v.prefix_padding_duration,
+                activation_threshold=v.activation_threshold,
+            )
+        except (ImportError, AttributeError, TypeError) as e:
+            logger.warning(
+                f"inference.VAD unavailable ({e}); falling back to silero plugin"
+            )
+            from livekit.plugins import silero
+
+            return silero.VAD.load(
+                min_speech_duration=v.min_speech_duration,
+                min_silence_duration=v.min_silence_duration,
+                prefix_padding_duration=v.prefix_padding_duration,
+                activation_threshold=v.activation_threshold,
+            )
+
+    def _build_turn_handling(self) -> dict:
+        th = self.config.turn_handling
+        opts: Dict[str, Any] = {
+            "endpointing": {
+                "mode": th.endpointing_mode,
+                "min_delay": th.endpointing_min_delay,
+                "max_delay": th.endpointing_max_delay,
+            },
+            "interruption": {
+                "enabled": th.interruptions_enabled,
+                "min_duration": th.min_interruption_duration,
+                "min_words": th.min_interruption_words,
+                "false_interruption_timeout": th.false_interruption_timeout,
+                "resume_false_interruption": th.resume_false_interruption,
+            },
+            "preemptive_generation": {"enabled": th.preemptive_generation},
+        }
+        if th.interruption_mode is not None:
+            opts["interruption"]["mode"] = th.interruption_mode
+        if th.turn_detection == "turn_detector":
+            from livekit.agents import inference
+
+            kwargs: Dict[str, Any] = {}
+            if th.turn_detector_version:
+                kwargs["version"] = th.turn_detector_version
+            if th.unlikely_threshold is not None:
+                kwargs["unlikely_threshold"] = th.unlikely_threshold
+            opts["turn_detection"] = inference.TurnDetector(**kwargs)
+        else:
+            opts["turn_detection"] = th.turn_detection
+        return opts
+
+    # ---- tools ------------------------------------------------------------
+
+    def _make_tool(self, tool: Tool):
+        from livekit.agents import RunContext
+        from livekit.agents.llm import ToolError, function_tool
+
+        try:
+            full = tool.openai_schema
+            raw_schema = full.get("function", full)
+        except Exception:
+            raw_schema = {
+                "name": tool.name,
+                "description": getattr(tool, "short_desc", "") or "",
+                "parameters": {"type": "object", "properties": {}},
+            }
+        name = raw_schema["name"]
+        provider = self
+
+        async def _bridge(raw_arguments: dict, context: RunContext) -> str:
+            call_id = context.function_call.call_id or str(uuid.uuid4())
+            if name in provider._write_tools:
+                try:
+                    context.disallow_interruptions()
+                except Exception:
+                    pass
+            fut: asyncio.Future = asyncio.get_running_loop().create_future()
+            provider._pending_tools[call_id] = fut
+            provider._emit(
+                CascadedEventType.TOOL_CALL,
+                {
+                    "tool_call": ToolCall(
+                        id=call_id, name=name, arguments=dict(raw_arguments or {})
+                    )
+                },
+            )
+            try:
+                result, is_error = await fut
+            finally:
+                provider._pending_tools.pop(call_id, None)
+            if is_error:
+                raise ToolError(result)
+            return result
+
+        _bridge.__name__ = name
+        # `from __future__ import annotations` stringifies hints; LiveKit resolves them
+        # with get_type_hints() at call time, so attach the real objects explicitly.
+        _bridge.__annotations__ = {"raw_arguments": dict, "context": RunContext, "return": str}
+        return function_tool(_bridge, raw_schema=raw_schema)
+
+    def resolve_tool(self, call_id: str, result: str, is_error: bool = False) -> None:
+        fut = self._pending_tools.get(call_id)
+        if fut is None:
+            logger.warning(
+                f"tool result for unknown call_id={call_id} (already cancelled?)"
+            )
+            return
+        if not fut.done():
+            fut.set_result((result or "", bool(is_error)))
+
+    # ---- audio ------------------------------------------------------------
+
+    def push_audio(self, pcm16: bytes) -> None:
+        if not self._connected or not self.audio_in:
+            return
+        self.audio_in.push(pcm16)
+        self.pushed_audio_bytes += len(pcm16)
+        self.stt_audio_seconds_sent += len(pcm16) / (
+            self.config.tts_input_sample_rate * 2
+        )
+
+    def drain_output(self, tick_ms: int) -> List[Tuple[bytes, str, int]]:
+        if not self.audio_out:
+            return []
+        return self.audio_out.drain(tick_ms)
+
+    # ---- session events ---------------------------------------------------
+
+    def _register_session_events(self, session) -> None:
+        emit = self._emit
+        sidecar = self._sidecar
+
+        @session.on("user_input_transcribed")
+        def _on_transcribed(ev):
+            sidecar(ev)
+            emit(
+                CascadedEventType.TRANSCRIPT_FINAL
+                if ev.is_final
+                else CascadedEventType.TRANSCRIPT_PARTIAL,
+                {"transcript": ev.transcript},
+            )
+
+        @session.on("user_state_changed")
+        def _on_user_state(ev):
+            sidecar(ev)
+            if ev.new_state == "speaking":
+                emit(CascadedEventType.SPEECH_STARTED)
+            elif ev.old_state == "speaking":
+                emit(CascadedEventType.SPEECH_ENDED)
+
+        @session.on("agent_state_changed")
+        def _on_agent_state(ev):
+            sidecar(ev)
+            if ev.new_state == "thinking":
+                emit(CascadedEventType.LLM_STARTED)
+
+        for name in (
+            "agent_false_interruption",
+            "overlapping_speech",
+            "function_tools_executed",
+            "conversation_item_added",
+            "user_transcription_timeout",
+            "close",
+        ):
+
+            def _mk(n):
+                def _h(ev):
+                    sidecar(ev)
+
+                return _h
+
+            session.on(name, _mk(name))
+
+        @session.on("error")
+        def _on_error(ev):
+            sidecar(ev)
+            emit(
+                CascadedEventType.ERROR,
+                {
+                    "error": str(getattr(ev, "error", ev)),
+                    "stage": type(getattr(ev, "source", None)).__name__,
+                },
+            )
+
+    def _register_metrics(self) -> None:
+        cfg = self.config
+
+        def _llm(ev):
+            m = getattr(ev, "metrics", ev)
+            self._sidecar(ev)
+            self._emit(
+                CascadedEventType.USAGE,
+                {
+                    "component": "llm",
+                    "provider": cfg.llm.provider,
+                    "model": cfg.llm.model,
+                    "prompt_tokens": getattr(m, "prompt_tokens", None),
+                    "completion_tokens": getattr(m, "completion_tokens", None),
+                    "prompt_cached_tokens": getattr(m, "prompt_cached_tokens", None),
+                    "ttft": getattr(m, "ttft", None),
+                },
+            )
+
+        def _tts(ev):
+            m = getattr(ev, "metrics", ev)
+            self._sidecar(ev)
+            self._emit(
+                CascadedEventType.USAGE,
+                {
+                    "component": "tts",
+                    "provider": cfg.tts.provider,
+                    "model": cfg.tts.model,
+                    "characters": getattr(m, "characters_count", None),
+                    "ttfb": getattr(m, "ttfb", None),
+                },
+            )
+
+        def _stt(ev):
+            self._sidecar(ev)
+
+        for obj, cb in ((self._llm, _llm), (self._tts, _tts), (self._stt, _stt)):
+            try:
+                obj.on("metrics_collected", cb)
+            except Exception as e:
+                logger.debug(f"could not subscribe metrics on {obj}: {e}")
