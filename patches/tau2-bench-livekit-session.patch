+"""Tests for the AgentSession-based cascaded provider.
+
+Pure tests (no network): tick-paced audio sinks and the adapter's event
+handling. Integration test (real Deepgram + OpenAI): skipped unless the API
+keys are present and ``TAU2_RUN_LIVEKIT_SESSION_TESTS=1``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+
+import pytest
+
+pytest.importorskip("livekit.agents")
+
+from livekit import rtc  # noqa: E402
+
+from tau2.voice.audio_native.livekit.provider import CascadedEventType  # noqa: E402
+from tau2.voice.audio_native.livekit_session.session_provider import (  # noqa: E402
+    TickAudioInput,
+    TickAudioOutput,
+    TickTextOutput,
+)
+
+
+def _frame(n_samples: int, sr: int = 24000, value: int = 1) -> rtc.AudioFrame:
+    data = (value).to_bytes(2, "little", signed=True) * n_samples
+    return rtc.AudioFrame(
+        data=data, sample_rate=sr, num_channels=1, samples_per_channel=n_samples
+    )
+
+
+def test_tick_audio_input_splits_into_20ms_frames():
+    async def run():
+        inp = TickAudioInput(16000)
+        inp.push(b"\x00\x00" * 3200)  # 200 ms @ 16 kHz
+        frames = []
+        for _ in range(10):
+            frames.append(await asyncio.wait_for(inp.impl.__anext__(), 1))
+        assert all(f.samples_per_channel == 320 for f in frames)
+        assert all(f.sample_rate == 16000 for f in frames)
+        inp.close()
+        with pytest.raises(StopAsyncIteration):
+            await inp.impl.__anext__()
+
+    asyncio.run(run())
+
+
+def test_tick_audio_output_paces_and_reports_playback():
+    async def run():
+        events = []
+        out = TickAudioOutput(lambda t, d=None: events.append((t, d or {})))
+        sink = out.impl
+        finished = []
+        sink.on("playback_finished", lambda ev: finished.append(ev))
+
+        # one 500 ms segment @ 24 kHz pushed all at once, then flushed
+        await sink.capture_frame(_frame(12000))
+        sink.flush()
+        assert events[0][0] == CascadedEventType.TTS_STARTED
+        item = events[0][1]["item_id"]
+
+        # drain 200 ms at a time -> 3 drains (200, 200, 100)
+        d1 = out.drain(200)
+        assert len(d1) == 1 and len(d1[0][0]) == 200 * 48 and d1[0][1] == item
+        assert not finished
+        d2 = out.drain(200)
+        assert len(d2[0][0]) == 200 * 48
+        d3 = out.drain(200)
+        assert len(d3[0][0]) == 100 * 48
+        assert len(finished) == 1 and finished[0].interrupted is False
+        assert abs(finished[0].playback_position - 0.5) < 1e-6
+        assert any(t == CascadedEventType.TTS_COMPLETED for t, _ in events)
+        assert out.drain(200) == []
+
+        # interruption mid-segment: clear_buffer discards and reports interrupted
+        await sink.capture_frame(_frame(24000))  # 1 s
+        out.drain(200)
+        sink.clear_buffer()
+        assert len(finished) == 2 and finished[1].interrupted is True
+        assert abs(finished[1].playback_position - 0.2) < 1e-6
+        assert events[-1][0] == CascadedEventType.INTERRUPTED
+        assert out.drain(200) == []
+
+        # pause/resume gates draining (false-interruption handling)
+        await sink.capture_frame(_frame(4800))
+        sink.pause()
+        assert out.drain(200) == []
+        sink.resume()
+        assert len(out.drain(200)) == 1
+
+    asyncio.run(run())
+
+
+def test_tick_text_output_segments():
+    events = []
+    txt = TickTextOutput(lambda t, d=None: events.append((t, d or {})))
+
+    async def run():
+        await txt.impl.capture_text("Hello ")
+        await txt.impl.capture_text("there.")
+        txt.impl.flush()
+        await txt.impl.capture_text("Second.")
+        txt.impl.flush()
+
+    asyncio.run(run())
+    tokens = [
+        (d["item_id"], d["token"])
+        for t, d in events
+        if t == CascadedEventType.LLM_TOKEN
+    ]
+    assert tokens == [("utt_1", "Hello "), ("utt_1", "there."), ("utt_2", "Second.")]
+    assert [
+        d["item_id"] for t, d in events if t == CascadedEventType.LLM_COMPLETED
+    ] == ["utt_1", "utt_2"]
+
+
+@pytest.mark.skipif(
+    not (
+        os.getenv("TAU2_RUN_LIVEKIT_SESSION_TESTS")
+        and os.getenv("DEEPGRAM_API_KEY")
+        and os.getenv("OPENAI_API_KEY")
+    ),
+    reason="needs DEEPGRAM_API_KEY, OPENAI_API_KEY and TAU2_RUN_LIVEKIT_SESSION_TESTS=1",
+)
+def test_adapter_end_to_end_with_tool(tmp_path):
+    """Feed one synthesized utterance, expect a transcript, a tool call, and agent audio."""
+    from tau2.environment.tool import Tool
+    from tau2.voice.audio_native.audio_converter import pcm16_to_telephony
+    from tau2.voice.audio_native.livekit_session.config import SESSION_CONFIGS
+    from tau2.voice.audio_native.livekit_session.discrete_time_adapter import (
+        LiveKitSessionAdapter,
+    )
+
+    def lookup_weather(city: str) -> str:
+        """Look up the weather for a city.
+
+        Args:
+            city: City name.
+        """
+        return "sunny"
+
+    tool = Tool(lookup_weather)
+    cfg = SESSION_CONFIGS["cascaded-session-vad"]
+    adapter = LiveKitSessionAdapter(
+        tick_duration_ms=200, session_config=cfg, sidecar_path=tmp_path / "ev.jsonl"
+    )
+    adapter.connect(
+        "You are a voice assistant. Always call lookup_weather when asked about weather, then answer in one sentence.",
+        [tool],
+    )
+    try:
+        # synthesize the user utterance with the agent's own TTS (no ElevenLabs needed)
+        from livekit.plugins import deepgram
+
+        async def synth():
+            tts = deepgram.TTS(model="aura-asteria-en")
+            pcm = bytearray()
+            async for ev in tts.synthesize("What is the weather in Tokyo?"):
+                pcm += bytes(ev.frame.data)
+            await tts.aclose()
+            return bytes(pcm), 24000
+
+        pcm, sr = asyncio.run(synth())
+        tel, _ = pcm16_to_telephony(pcm, sr)
+        silence = b"\x7f" * 1600
+        chunks = [tel[i : i + 1600] for i in range(0, len(tel), 1600)]
+        got_transcript = got_tool = got_audio = False
+        tick = 0
+        for i in range(len(chunks) + 150):  # ~30 s budget
+            audio = chunks[i] if i < len(chunks) else silence
+            res = adapter.run_tick(audio.ljust(1600, b"\x7f"), tick_number=tick)
+            tick += 1
+            if any(e.type == CascadedEventType.TRANSCRIPT_FINAL for e in res.events):
+                got_transcript = True
+            if res.tool_calls:
+                got_tool = True
+                for tc in res.tool_calls:
+                    adapter.send_tool_result(
+                        tc.id, "sunny with a temperature of 70 degrees"
+                    )
+            if res.agent_audio_bytes > 0:
+                got_audio = True
+            if got_transcript and got_tool and got_audio:
+                break
+        assert got_transcript, "no final transcript from STT"
+        assert got_tool, "agent never called the tool"
+        assert got_audio, "agent produced no audio"
+        assert (tmp_path / "ev.jsonl").exists()
+        assert any(r.component == "llm" for r in adapter.get_usage_records())
+    finally:
+        adapter.disconnect()
+
+
+def _local_up(url: str) -> bool:
+    import urllib.request
+
+    try:
+        urllib.request.urlopen(url, timeout=2)
+        return True
+    except Exception:
+        return False
+
+
+@pytest.mark.skipif(
+    not (
+        _local_up("http://localhost:8000/health")
+        and _local_up("http://localhost:8880/health")
+        and _local_up("http://localhost:11434/api/version")
+    ),
+    reason="needs the local stack (scripts/local_stack.sh up): STT :8000, TTS :8880, Ollama :11434",
+)
+def test_adapter_end_to_end_local_stack(tmp_path):
+    """Fully local, keyless end-to-end tick loop: local Kokoro synthesizes the user
+    utterance, the AgentSession runs local whisper → Ollama llama3.1:8b → Kokoro,
+    and a τ-bench-style tool round-trips through the bridge."""
+    import json
+    import urllib.request
+
+    from tau2.environment.tool import Tool
+    from tau2.voice.audio_native.audio_converter import pcm16_to_telephony
+    from tau2.voice.audio_native.livekit_session.config import SESSION_CONFIGS
+    from tau2.voice.audio_native.livekit_session.discrete_time_adapter import (
+        LiveKitSessionAdapter,
+    )
+
+    def lookup_weather(city: str) -> str:
+        """Look up the current weather for a city.
+
+        Args:
+            city: City name.
+        """
+        return "sunny"
+
+    tool = Tool(lookup_weather)
+    adapter = LiveKitSessionAdapter(
+        tick_duration_ms=200,
+        session_config=SESSION_CONFIGS["local"],
+        sidecar_path=tmp_path / "ev.jsonl",
+    )
+    adapter.connect(
+        "You are a voice assistant. When asked about the weather you MUST call the "
+        "lookup_weather tool first, then answer in one short sentence.",
+        [tool],
+    )
+    try:
+        req = urllib.request.Request(
+            "http://localhost:8880/v1/audio/speech",
+            data=json.dumps(
+                {"input": "Hello. What is the weather like in Tokyo today?", "voice": "af_heart", "response_format": "pcm"}
+            ).encode(),
+            headers={"Content-Type": "application/json"},
+        )
+        pcm = urllib.request.urlopen(req, timeout=120).read()
+        tel, _ = pcm16_to_telephony(pcm, 24000)
+        silence = b"\x7f" * 1600
+        chunks = [tel[i : i + 1600] for i in range(0, len(tel), 1600)]
+        got_transcript = got_tool = got_audio = False
+        for i in range(len(chunks) + 300):  # up to ~60 s of ticks after the utterance
+            audio = chunks[i] if i < len(chunks) else silence
+            res = adapter.run_tick(audio.ljust(1600, b"\x7f"), tick_number=i + 1)
+            if any(e.type == CascadedEventType.TRANSCRIPT_FINAL for e in res.events):
+                got_transcript = True
+            if res.tool_calls:
+                got_tool = True
+                for tc in res.tool_calls:
+                    adapter.send_tool_result(tc.id, "sunny with a temperature of 70 degrees")
+            if res.agent_audio_bytes > 0:
+                got_audio = True
+            if got_transcript and got_tool and got_audio:
+                break
+        assert got_transcript, "no final transcript from local STT"
+        assert got_tool, "agent never called the tool"
+        assert got_audio, "agent produced no audio"
+        assert (tmp_path / "ev.jsonl").exists()
+    finally:
+        adapter.disconnect()
