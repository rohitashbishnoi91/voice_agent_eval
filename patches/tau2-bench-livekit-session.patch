index 0000000..fb30fae
--- /dev/null
+++ b/src/tau2/voice/utils/local_tts_utils.py
@@ -0,0 +1,193 @@
+"""Keyless TTS backends for the τ-bench voice user simulator.
+
+- ``kokoro``: fully local Kokoro (ONNX, CPU). American/British English voices only,
+  so the *accent* dimension of the ``regular`` speech complexity is weakened
+  (documented limitation). Model files (~330 MB) download once.
+- ``edge``: Microsoft Edge neural voices via ``edge-tts`` (network, no API key).
+  Offers accented English (en-IN, en-SG, en-HK, en-NG, fr-FR, zh-CN speaking
+  English), so personas keep an accent signal. Not local.
+
+Both return 16 kHz PCM16 mono ``AudioData`` — the same format as the ElevenLabs
+path (``DEFAULT_ELEVEN_LAB_AUDIO_FORMAT``) — so all downstream effects
+(noise, telephony, frame drops) apply unchanged.
+
+Persona → voice maps can be overridden with ``TAU2_KOKORO_VOICE_<PERSONA>`` /
+``TAU2_EDGE_VOICE_<PERSONA>`` (persona names upper-cased, e.g. PRIYA_PATIL).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import io
+import os
+import re
+from pathlib import Path
+from typing import Optional
+
+import numpy as np
+from loguru import logger
+
+from tau2.data_model.audio import AudioData, AudioEncoding, AudioFormat
+
+# --- Force IPv4: on this machine IPv6 connections to model CDNs hang in SYN_SENT ---
+import socket as _socket
+
+_orig_getaddrinfo = _socket.getaddrinfo
+
+
+def _ipv4_first(*args, **kwargs):
+    res = _orig_getaddrinfo(*args, **kwargs)
+    v4 = [r for r in res if r[0] == _socket.AF_INET]
+    return v4 or res
+
+
+_socket.getaddrinfo = _ipv4_first
+
+TARGET_SR = 16000
+TARGET_FORMAT = AudioFormat(encoding=AudioEncoding.PCM_S16LE, sample_rate=TARGET_SR)
+
+# ElevenLabs v3 audio tags such as [cough] / [sneeze] / [pause] are not understood
+# by these engines; drop them (the vocal-tic *timing* effects are still applied by
+# the effects pipeline on the audio, only the spoken tic sound is lost).
+_TAG_RE = re.compile(r"\[[a-zA-Z _-]+\]")
+
+KOKORO_VOICES = {
+    # control (American)
+    "matt_delaney": "am_michael",
+    "lisa_brenner": "af_sarah",
+    # regular — Kokoro has no accented-English voices; use distinct US/UK voices
+    "mildred_kaplan": "bf_emma",
+    "arjun_roy": "am_fenrir",
+    "wei_lin": "af_nicole",
+    "mamadou_diallo": "bm_george",
+    "priya_patil": "af_alloy",
+}
+EDGE_VOICES = {
+    "matt_delaney": "en-US-GuyNeural",
+    "lisa_brenner": "en-US-AriaNeural",
+    "mildred_kaplan": "en-GB-SoniaNeural",
+    "arjun_roy": "en-IN-PrabhatNeural",  # Indian-subcontinent accent (closest to Bengali)
+    "wei_lin": "en-HK-YanNeural",  # Cantonese-accented English (closest to Sichuan Mandarin)
+    "mamadou_diallo": "fr-FR-HenriNeural",  # French voice reading English → French accent
+    "priya_patil": "en-IN-NeerjaNeural",
+}
+
+
+def _voice_for(persona_name: Optional[str], table: dict, env_prefix: str, default: str) -> str:
+    if persona_name:
+        env = os.environ.get(f"{env_prefix}_{persona_name.upper()}")
+        if env:
+            return env
+        return table.get(persona_name, default)
+    return default
+
+
+def _clean_text(text: str) -> str:
+    text = _TAG_RE.sub("", text)
+    return re.sub(r"\s{2,}", " ", text).strip()
+
+
+def _to_audio_data(samples: np.ndarray, sr: int) -> AudioData:
+    if sr != TARGET_SR:
+        n = int(len(samples) * TARGET_SR / sr)
+        samples = np.interp(np.linspace(0, len(samples) - 1, n), np.arange(len(samples)), samples)
+    pcm = (np.clip(samples.astype(np.float32), -1.0, 1.0) * 32767).astype("<i2").tobytes()
+    return AudioData(data=pcm, format=TARGET_FORMAT)
+
+
+# ---------------------------------------------------------------- Kokoro (local)
+_kokoro = None
+
+
+
+_HF_BASE = "https://huggingface.co/onnx-community/Kokoro-82M-v1.0-ONNX/resolve/main/"
+_HF_ENGLISH_VOICES = (
+    "af_alloy af_aoede af_bella af_heart af_jessica af_kore af_nicole af_nova af_river af_sarah af_sky "
+    "am_adam am_echo am_eric am_fenrir am_liam am_michael am_onyx am_puck "
+    "bf_alice bf_emma bf_isabella bf_lily bm_daniel bm_fable bm_george bm_lewis"
+).split()
+
+
+def ensure_kokoro_files(cache: Optional[Path] = None) -> tuple[Path, Path]:
+    """Return (model.onnx, voices.npz) paths, downloading from Hugging Face on first use.
+
+    Uses the onnx-community export (same weights as the kokoro-onnx GitHub release,
+    which is far slower to download from here) and builds the voices archive that
+    ``kokoro_onnx`` expects (npz keyed by voice name, arrays of shape (510, 1, 256)).
+    """
+    import urllib.request
+
+    cache = Path(cache or os.environ.get("KOKORO_CACHE", Path.home() / ".cache" / "kokoro-onnx"))
+    cache.mkdir(parents=True, exist_ok=True)
+    model, voices = cache / "kokoro-v1.0.onnx", cache / "voices-v1.0.bin"
+    if not model.exists() or model.stat().st_size < 100_000_000:
+        logger.info(f"downloading Kokoro model → {model}")
+        urllib.request.urlretrieve(_HF_BASE + "onnx/model.onnx", str(model) + ".part")
+        os.replace(str(model) + ".part", model)
+    try:
+        ok = voices.exists() and len(np.load(voices).files) >= 20
+    except Exception:
+        ok = False
+    if not ok:
+        logger.info(f"downloading Kokoro voices → {voices}")
+        vdir = cache / "hf_voices"
+        vdir.mkdir(exist_ok=True)
+        table = {}
+        for name in _HF_ENGLISH_VOICES:
+            p = vdir / f"{name}.bin"
+            if not p.exists() or p.stat().st_size < 100_000:
+                urllib.request.urlretrieve(_HF_BASE + f"voices/{name}.bin", p)
+            arr = np.fromfile(p, dtype=np.float32)
+            if arr.size % 256 == 0:
+                table[name] = arr.reshape(-1, 1, 256)
+        with open(voices, "wb") as fh:
+            np.savez(fh, **table)
+    return model, voices
+
+
+def _get_kokoro():
+    global _kokoro
+    if _kokoro is None:
+        from kokoro_onnx import Kokoro
+
+        model, voices = ensure_kokoro_files()
+        _kokoro = Kokoro(str(model), str(voices))
+    return _kokoro
+
+
+def tts_kokoro(text: str, persona_name: Optional[str] = None, speed: float = 1.0) -> AudioData:
+    voice = _voice_for(persona_name, KOKORO_VOICES, "TAU2_KOKORO_VOICE", "af_heart")
+    clean = _clean_text(text) or "."
+    samples, sr = _get_kokoro().create(clean, voice=voice, speed=speed, lang="en-us")
+    return _to_audio_data(np.asarray(samples), sr)
+
+
+# ---------------------------------------------------------------- Edge (keyless network)
+def tts_edge(text: str, persona_name: Optional[str] = None, rate: str = "+0%") -> AudioData:
+    import edge_tts
+    from pydub import AudioSegment
+
+    voice = _voice_for(persona_name, EDGE_VOICES, "TAU2_EDGE_VOICE", "en-US-AriaNeural")
+    clean = _clean_text(text) or "."
+
+    async def _run() -> bytes:
+        buf = io.BytesIO()
+        async for chunk in edge_tts.Communicate(clean, voice, rate=rate).stream():
+            if chunk["type"] == "audio":
+                buf.write(chunk["data"])
+        return buf.getvalue()
+
+    try:
+        loop = asyncio.get_running_loop()
+    except RuntimeError:
+        loop = None
+    if loop and loop.is_running():
+        # called from inside an event loop thread: run in a fresh thread
+        import concurrent.futures
+
+        with concurrent.futures.ThreadPoolExecutor(1) as ex:
+            mp3 = ex.submit(lambda: asyncio.run(_run())).result()
+    else:
+        mp3 = asyncio.run(_run())
+    seg = AudioSegment.from_file(io.BytesIO(mp3), format="mp3").set_channels(1).set_frame_rate(TARGET_SR).set_sample_width(2)
+    return AudioData(data=seg.raw_data, format=TARGET_FORMAT)
