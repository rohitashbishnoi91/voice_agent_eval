+"""LiveKit AgentSession-based cascaded voice provider (STT → LLM → TTS).
+
+Runs a real ``livekit.agents.AgentSession`` inside the τ-bench tick loop, so the
+system under test is a genuine LiveKit voice agent: LiveKit's turn detector,
+endpointing, (adaptive) interruption handling, preemptive generation and tool
+execution are all exercised. Audio enters and leaves the session through
+custom ``AudioInput``/``AudioOutput`` sinks paced by the 200 ms simulation
+ticks; τ-bench tool calls are bridged through LiveKit function tools whose
+results are delivered on the next tick.
+
+Compare with ``tau2.voice.audio_native.livekit`` which drives LiveKit *plugins*
+directly and lets Deepgram's VAD decide turns.
+
+Usage (CLI):
+    tau2 run --domain retail --audio-native --audio-native-provider livekit_session \
+        --cascaded-config cascaded-session [--agent-prompt-file prompts/v1.md]
+"""
+
+from tau2.voice.audio_native.livekit_session.config import (
+    SESSION_CONFIGS,
+    SessionConfig,
+    TurnHandlingConfig,
+    VADConfig,
+)
+from tau2.voice.audio_native.livekit_session.discrete_time_adapter import (
+    LiveKitSessionAdapter,
+)
+from tau2.voice.audio_native.livekit_session.session_provider import (
+    SessionVoiceProvider,
+)
+
+__all__ = [
+    "LiveKitSessionAdapter",
+    "SESSION_CONFIGS",
+    "SessionConfig",
+    "SessionVoiceProvider",
+    "TurnHandlingConfig",
+    "VADConfig",
+]
