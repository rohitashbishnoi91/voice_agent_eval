# ===== LOCAL STACK (default; no keys) =====
# Nothing required. `scripts/local_stack.sh up` starts Ollama (llama3.1:8b), a local
# faster-whisper STT server (:8000) and a Kokoro TTS server (:8880). The tau2 user
# simulator uses Kokoro voices in-process (TAU2_VOICE_SYNTHESIS_PROVIDER=kokoro) and
# Ollama via LiteLLM (ollama_chat/llama3.1:8b). Optional overrides:
# OLLAMA_MODEL=llama3.1:8b        LOCAL_STT_MODEL=small.en
# TAU2_VOICE_SYNTHESIS_PROVIDER=edge   # keyless Microsoft Edge voices (network) — keeps accents
# TAU2_KOKORO_VOICE_PRIYA_PATIL=af_bella   # per-persona voice overrides (also TAU2_EDGE_VOICE_*)

# ===== PAID / LEADERBOARD-COMPARABLE STACK (STACK=paid) =====
# Copy to external/tau2-bench/.env (tau2 reads .env from its own directory)
# and to ~/livekit-agent-evals/.env for the LiveKit-native text tests.

# --- Agent under test (cascaded pipeline) ---
OPENAI_API_KEY=            # gpt-4.1 (agent LLM); also tau2 user simulator (gpt-4.1) and default judges
DEEPGRAM_API_KEY=          # nova-3 STT + aura-asteria-en TTS; tau2 also uses Deepgram to transcribe agent audio

# --- tau2 voice user simulator ---
ELEVENLABS_API_KEY=        # persona voices (hard dependency of tau2 synthesis)
# Generated by: python -m tau2.voice.scripts.setup_voices   (paste the printed lines)
TAU2_VOICE_ID_MATT_DELANEY=
TAU2_VOICE_ID_LISA_BRENNER=
TAU2_VOICE_ID_MILDRED_KAPLAN=
TAU2_VOICE_ID_ARJUN_ROY=
TAU2_VOICE_ID_WEI_LIN=
TAU2_VOICE_ID_MAMADOU_DIALLO=
TAU2_VOICE_ID_PRIYA_PATIL=

# --- Optional ---
ANTHROPIC_API_KEY=         # tau2 hallucination reviewer / `tau2 review` default model (claude-opus-4-5).
                           # Without it, pass --review-model gpt-4.1 and --hallucination-retries 0, or see scripts/run_retail.sh.

# --- LiveKit Cloud (optional but recommended) ---
# Needed for the hosted audio turn detector (v1) and adaptive interruption handling.
# Without these, use --cascaded-config cascaded-session-mini (local v1-mini turn detector, VAD interruptions).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
